# --- Порты хоста ---
HTTPS_PORT=443
MYSQL_PORT=3306
MAILPIT_UI_PORT=8025
PMA_PORT=8080

# --- БД ---
MYSQL_DATABASE=b2b_crm
MYSQL_USER=b2b_crm
MYSQL_PASSWORD=b2b_crm_dev_password
MYSQL_ROOT_PASSWORD=b2b_crm_root_password
DATABASE_URL=mysql://b2b_crm:b2b_crm_dev_password@mysql:3306/b2b_crm?serverVersion=8.4

# --- Mailer (dev: Mailpit внутри сети compose) ---
MAILER_DSN=smtp://mailpit:1025

# --- Приложение ---
APP_SECRET=dev_b2b_crm_change_me
ENABLE_FIXTURES=1

# --- Xdebug ---
XDEBUG_MODE=debug

# --- E2E ---
# URL по умолчанию для сервиса e2e (внутри сети compose резолвится b2b-crm.local).
# Для запуска из контейнера OpenCode: BASE_URL=https://host.docker.internal
BASE_URL=https://b2b-crm.local
