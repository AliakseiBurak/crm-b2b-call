{% extends 'base.html.twig' %}

{% block title %}Вход{% endblock %}

{% block body %}
    <h1>Вход</h1>

    {% if error %}
        <div class="alert alert-error" role="alert">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
    {% endif %}

    <form method="post" action="{{ path('app_login') }}">
        <label>
            Email
            <input type="email" name="_username" value="{{ last_username }}" required autofocus>
        </label>
        <label>
            Пароль
            <input type="password" name="_password" required>
        </label>
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
        <label>
            <input type="checkbox" name="_remember_me">
            Запомнить меня
        </label>
        <button type="submit">Войти</button>
    </form>
{% endblock %}
