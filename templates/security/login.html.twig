{% extends 'base.html.twig' %}

{% block title %}Вход{% endblock %}

{% block body %}
    <section class="section section--white">
        <div class="container">
            <h1>Вход</h1>

            {% if error %}
                <div class="alert alert-error" role="alert">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
            {% endif %}

            <form method="post" action="{{ path('app_login') }}">
                {{ include('components/form_field.html.twig', { name: '_username', label: 'Email', type: 'email', value: last_username|default(''), required: true, autofocus: true }) }}
                {{ include('components/form_field.html.twig', { name: '_password', label: 'Пароль', type: 'password', required: true }) }}
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                <label class="field__consent">
                    <input type="checkbox" name="_remember_me">
                    Запомнить меня
                </label>
                {% include 'components/button.html.twig' with { variant: 'primary', text: 'Войти' } %}
            </form>
        </div>
    </section>
{% endblock %}