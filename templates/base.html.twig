<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" href="data:,">
    <title>{% block title %}B2B Call CRM{% endblock %}</title>
    {% block stylesheets %}{{ encore_entry_link_tags('app') }}{% endblock %}
</head>
<body>
    {% set baseMenu = app.user
        ? [
            { label: 'Панель', href: path('app_dashboard') },
            { label: 'Рассылки', href: path('app_campaign_index') },
        ]
        : []
    %}
    {% if app.user and is_granted('ROLE_MANAGER') and not is_granted('ROLE_ADMIN') %}
        {% set baseMenu = baseMenu|merge([{ label: 'Мои группы', href: path('app_group_list') }]) %}
    {% endif %}
    {% if app.user and is_granted('ROLE_ADMIN') %}
        {% set baseMenu = baseMenu|merge([
            { label: 'Группы', href: path('app_group_list') },
            { label: 'Пользователи', href: path('app_user_list') },
        ]) %}
    {% endif %}
    {% if app.user %}
        {% set baseMenu = baseMenu|merge([{ label: 'Выйти', href: path('app_logout') }]) %}
    {% else %}
        {% set baseMenu = [{ label: 'Войти', href: path('app_login') }] %}
    {% endif %}
    {% set menu = baseMenu %}

    {{ include('components/header.html.twig', { menu: menu }) }}

    {% block flashes %}
        {% for label, messages in app.flashes %}
            <div class="container">
                {% for message in messages %}
                    <div class="alert alert--{{ label == 'error' ? 'error' : 'warning' }}" role="alert">{{ message }}</div>
                {% endfor %}
            </div>
        {% endfor %}
    {% endblock %}

    <main>
        {% block body %}{% endblock %}
    </main>

    {{ include('components/footer.html.twig', { menu: menu }) }}

    {% block javascripts %}{{ encore_entry_script_tags('app') }}{% endblock %}
</body>
</html>