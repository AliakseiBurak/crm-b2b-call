<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" href="data:,">
    <title>{% block title %}B2B Call CRM{% endblock %}</title>
    {% block stylesheets %}{{ encore_entry_link_tags('app') }}{% endblock %}
</head>
<body>
    {% set menu = app.user
        ? [
            { label: 'Панель', href: path('app_dashboard') },
            { label: 'Выйти', href: path('app_logout') },
        ]
        : [
            { label: 'Войти', href: path('app_login') },
        ]
    %}

    {{ include('components/header.html.twig', { menu: menu }) }}

    <main>
        {% block body %}{% endblock %}
    </main>

    {{ include('components/footer.html.twig', { menu: menu }) }}

    {% block javascripts %}{{ encore_entry_script_tags('app') }}{% endblock %}
</body>
</html>