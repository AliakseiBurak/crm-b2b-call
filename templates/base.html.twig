<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}B2B Call CRM{% endblock %}</title>
    {% block stylesheets %}{{ encore_entry_link_tags('app') }}{% endblock %}
</head>
<body>
    {% set menu = app.user
        ? [
            { label: 'Главная', href: path('app_home') },
            { label: 'Панель', href: path('app_dashboard') },
            { label: 'Выйти', href: path('app_logout') },
        ]
        : [
            { label: 'Главная', href: path('app_home') },
            { label: 'Войти', href: path('app_login') },
        ]
    %}

    {{ include('components/header.html.twig', { menu: menu }) }}

    <main>
        {% block body %}{% endblock %}
    </main>

    {{ include('components/footer.html.twig', { menu: menu }) }}

    {% embed 'components/modal.html.twig' with { id: 'modal-call', title: 'Заказать звонок' } %}
        {% block modal_body %}
            <form id="modal-call-form" action="#" method="post">
                {{ include('components/form_field.html.twig', { name: 'call_name', label: 'Ваше имя', type: 'text', required: true, on_band: true }) }}
                {{ include('components/form_field.html.twig', { name: 'call_phone', label: 'Телефон', type: 'tel', placeholder: '+7 (___) ___-__-__', required: true, on_band: true }) }}
                <label class="field__consent">
                    <input type="checkbox" name="call_consent" required>
                    Согласие на обработку персональных данных
                </label>
                {{ include('components/button.html.twig', { variant: 'primary', text: 'Отправить заявку' }) }}
            </form>
            <p id="modal-call-success" hidden>Спасибо! Менеджер свяжется с вами в ближайшее время.</p>
        {% endblock %}
    {% endembed %}

    {% block javascripts %}{{ encore_entry_script_tags('app') }}{% endblock %}
</body>
</html>