{#
    Подтверждение удаления группы (change organization-groups).
    Уточняет, что удаляется только группа и связи: организации остаются.
    Ожидает: group (OrganizationGroup).
#}
{% extends 'base.html.twig' %}

{% block title %}Удаление группы{% endblock %}

{% block body %}
    <section class="section section--white">
        <div class="container">
            <h1>Удаление группы</h1>

            <p class="group-delete__warning">
                Группа «{{ group.name }}» будет удалена. Действие необратимо.
            </p>
            <ul class="group-delete__details">
                <li>Организации ({{ group.memberships|length }}) останутся в системе — будут удалены только записи о членстве в этой группе.</li>
                <li>Назначения группы менеджерам ({{ group.assignments|length }}) будут удалены.</li>
            </ul>

            <form method="post" action="{{ path('app_group_remove', { id: group.id }) }}" class="group-form__actions">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('group') }}">
                {{ include('components/button.html.twig', { variant: 'secondary', text: 'Удалить' }) }}
                {{ include('components/button.html.twig', {
                    variant: 'secondary',
                    text: 'Отмена',
                    href: path('app_group_list'),
                    type: 'button',
                }) }}
            </form>
        </div>
    </section>
{% endblock %}
