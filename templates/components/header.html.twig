{#
    Шапка (spec): белый фон, логотип слева (→ главная), пункты меню
    в верхней строке, для вошедших — кнопки «Создать организацию»/«Создать контакт».
    Параметры: menu — массив {label, href, active}
#}
<header class="header">
    <div class="header__top">
        <div class="header__top-inner">
            <a class="header__logo" href="{{ path('app_home') }}">B2B Call CRM</a>
            {% if menu %}
                <nav class="header__nav" aria-label="Основное меню">
                    {% for item in menu %}
                        <a class="header__menu-link" href="{{ item.href }}"{% if item.active is defined and item.active %} aria-current="page"{% endif %}>{{ item.label }}</a>
                    {% endfor %}
                </nav>
            {% endif %}
            {% if app.user %}
                <div class="header__create">
                    <a class="btn btn--secondary" href="/organizations/new">Создать организацию</a>
                    <a class="btn btn--secondary" href="/contacts/new">Создать контакт</a>
                    <a class="btn btn--secondary" href="{{ path('app_call_new') }}">Создать звонок</a>
                    <a class="btn btn--secondary" href="{{ path('app_campaign_new') }}">Создать рассылку</a>
                </div>
            {% endif %}
        </div>
    </div>
</header>