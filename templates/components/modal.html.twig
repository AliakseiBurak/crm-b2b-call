{#
    Модальное окно (spec 2.6): зелёный градиент, radius 10px,
    белая шапка 1.5rem, backdrop чёрный 60%.
    Параметры: id, title; содержимое — блок modal_body.
#}
<div class="modal" id="{{ id }}" role="dialog" aria-modal="true" aria-labelledby="{{ id }}-title">
    <div class="modal__backdrop" data-modal-close></div>
    <div class="modal__dialog">
        <div class="modal__header">
            <span id="{{ id }}-title">{{ title }}</span>
            <button class="modal__close" type="button" data-modal-close aria-label="Закрыть">&times;</button>
        </div>
        <div class="modal__body">
            {% block modal_body %}{% endblock %}
        </div>
    </div>
</div>